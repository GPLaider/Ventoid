<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ventoid_window"
    android:clipToPadding="true"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/ventoid_space_screen"
        android:paddingTop="@dimen/ventoid_space_screen"
        android:paddingEnd="@dimen/ventoid_space_screen"
        android:paddingBottom="@dimen/ventoid_space_screen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/ventoid_logo_size"
                android:layout_height="@dimen/ventoid_logo_size"
                android:contentDescription="@string/app_name"
                android:scaleType="centerInside"
                android:src="@drawable/ventoid_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ventoid_space_standard"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/VentoidText.AppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hero_title" />

                <TextView
                    style="@style/VentoidText.Subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ventoid_space_tiny"
                    android:text="@string/hero_subtitle" />
            </LinearLayout>

            <TextView
                style="@style/VentoidText.Status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/pill_status"
                android:gravity="center"
                android:paddingStart="@dimen/ventoid_status_padding_horizontal"
                android:paddingTop="@dimen/ventoid_status_padding_vertical"
                android:paddingEnd="@dimen/ventoid_status_padding_horizontal"
                android:paddingBottom="@dimen/ventoid_status_padding_vertical"
                android:text="@string/hero_status" />
        </LinearLayout>

        <LinearLayout
            style="@style/VentoidPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ventoid_space_standard">

            <TextView
                style="@style/VentoidText.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/drive_setup_title" />

            <TextView
                style="@style/VentoidText.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_standard"
                android:text="@string/device_label" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_compact"
                android:orientation="horizontal">

                <Spinner
                    android:id="@+id/spinner_usb"
                    style="@style/VentoidSpinner"
                    android:layout_width="0dp"
                    android:layout_weight="1" />

                <Button
                    android:id="@+id/button_refresh"
                    style="@style/VentoidButton.Secondary"
                    android:layout_width="@dimen/ventoid_command_width"
                    android:layout_marginStart="@dimen/ventoid_space_small"
                    android:text="@string/refresh" />
            </LinearLayout>

            <TextView
                style="@style/VentoidText.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_standard"
                android:text="@string/partition_scheme_title" />

            <Spinner
                android:id="@+id/spinner_partition_scheme"
                style="@style/VentoidSpinner"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ventoid_space_compact" />

            <TextView
                style="@style/VentoidText.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_standard"
                android:labelFor="@id/edit_reserved_space"
                android:text="@string/reserved_space_title" />

            <EditText
                android:id="@+id/edit_reserved_space"
                android:importantForAutofill="no"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_compact"
                android:backgroundTint="@color/ventoid_primary"
                android:imeOptions="actionDone"
                android:inputType="number"
                android:maxLines="1"
                android:selectAllOnFocus="true"
                android:text="@string/reserved_space_default"
                android:textColor="@color/ventoid_text_primary"
                android:textColorHint="@color/ventoid_text_secondary" />

            <TextView
                style="@style/VentoidText.Supporting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_tiny"
                android:text="@string/reserved_space_help" />

            <TextView
                style="@style/VentoidText.FieldLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_standard"
                android:text="@string/bundled_efi_label" />

            <TextView
                android:id="@+id/text_secure_boot_status"
                style="@style/VentoidReadOnlyField"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_compact"
                android:text="@string/secure_boot_checking" />
        </LinearLayout>

        <LinearLayout
            style="@style/VentoidPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ventoid_space_standard">

            <TextView
                style="@style/VentoidText.SectionTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/progress_title" />

            <TextView
                android:id="@+id/text_stage_title"
                style="@style/VentoidText.BodyCompact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ventoid_space_small"
                android:text="@string/progress_idle" />

            <LinearLayout
                style="@style/VentoidProgressStep"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ventoid_space_small">

                <TextView
                    style="@style/VentoidText.ProgressIndex"
                    android:layout_width="@dimen/ventoid_progress_index_width"
                    android:text="@string/progress_step_number_1" />

                <TextView
                    android:id="@+id/text_stage_boot_label"
                    style="@style/VentoidText.ProgressLabel"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/ventoid_space_small"
                    android:layout_weight="1"
                    android:text="@string/progress_step_boot_record" />

                <TextView
                    android:id="@+id/text_stage_boot_state"
                    style="@style/VentoidText.ProgressState"
                    android:layout_width="@dimen/ventoid_progress_state_width"
                    android:text="@string/progress_state_pending" />
            </LinearLayout>

            <LinearLayout
                style="@style/VentoidProgressStep"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ventoid_space_tiny">

                <TextView
                    style="@style/VentoidText.ProgressIndex"
                    android:layout_width="@dimen/ventoid_progress_index_width"
                    android:text="@string/progress_step_number_2" />

                <TextView
                    android:id="@+id/text_stage_core_label"
                    style="@style/VentoidText.ProgressLabel"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/ventoid_space_small"
                    android:layout_weight="1"
                    android:text="@string/progress_step_core" />

                <TextView
                    android:id="@+id/text_stage_core_state"
                    style="@style/VentoidText.ProgressState"
                    android:layout_width="@dimen/ventoid_progress_state_width"
                    android:text="@string/progress_state_pending" />
            </LinearLayout>

            <LinearLayout
                style="@style/VentoidProgressStep"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ventoid_space_tiny">

                <TextView
                    style="@style/VentoidText.ProgressIndex"
                    android:layout_width="@dimen/ventoid_progress_index_width"
                    android:text="@string/progress_step_number_3" />

                <TextView
                    android:id="@+id/text_stage_data_label"
                    style="@style/VentoidText.ProgressLabel"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/ventoid_space_small"
                    android:layout_weight="1"
                    android:text="@string/progress_step_data" />

                <TextView
                    android:id="@+id/text_stage_data_state"
                    style="@style/VentoidText.ProgressState"
                    android:layout_width="@dimen/ventoid_progress_state_width"
                    android:text="@string/progress_state_pending" />
            </LinearLayout>

            <LinearLayout
                style="@style/VentoidProgressStep"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ventoid_space_tiny">

                <TextView
                    style="@style/VentoidText.ProgressIndex"
                    android:layout_width="@dimen/ventoid_progress_index_width"
                    android:text="@string/progress_step_number_4" />

                <TextView
                    android:id="@+id/text_stage_efi_label"
                    style="@style/VentoidText.ProgressLabel"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/ventoid_space_small"
                    android:layout_weight="1"
                    android:text="@string/progress_step_efi" />

                <TextView
                    android:id="@+id/text_stage_efi_state"
                    style="@style/VentoidText.ProgressState"
                    android:layout_width="@dimen/ventoid_progress_state_width"
                    android:text="@string/progress_state_pending" />
            </LinearLayout>

            <LinearLayout
                style="@style/VentoidProgressStep"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ventoid_space_tiny">

                <TextView
                    style="@style/VentoidText.ProgressIndex"
                    android:layout_width="@dimen/ventoid_progress_index_width"
                    android:text="@string/progress_step_number_5" />

                <TextView
                    android:id="@+id/text_stage_verify_label"
                    style="@style/VentoidText.ProgressLabel"
                    android:layout_width="0dp"
                    android:layout_marginStart="@dimen/ventoid_space_small"
                    android:layout_weight="1"
                    android:text="@string/progress_step_verify" />

                <TextView
                    android:id="@+id/text_stage_verify_state"
                    style="@style/VentoidText.ProgressState"
                    android:layout_width="@dimen/ventoid_progress_state_width"
                    android:text="@string/progress_state_pending" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/VentoidText.Supporting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ventoid_space_standard"
            android:text="@string/install_warning"
            android:textColor="@color/ventoid_warning" />

        <Button
            android:id="@+id/button_install"
            style="@style/VentoidButton.Primary"
            android:layout_width="match_parent"
            android:layout_marginTop="@dimen/ventoid_space_small"
            android:text="@string/install_ventoy" />
    </LinearLayout>
</ScrollView>
